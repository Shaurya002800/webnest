{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "regions": ["iad1"],
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/handler?route=:route*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
